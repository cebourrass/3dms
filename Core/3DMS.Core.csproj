<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logique métier partagée (lecture des sessions, tours, virages, statistiques), sans dépendance à l'UI.
       Utilisée par l'appli WPF, l'outil de mesures du profil pilote et le futur serveur MCP. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Analyzer</RootNamespace>
    <AssemblyName>3DMS.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

</Project>
