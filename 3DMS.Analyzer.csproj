<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Analyzer</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sous-projets (Core, outils) : compilés par leur propre .csproj -->
    <Compile Remove="Core/**;Tools/**" />
    <None Remove="Core/**;Tools/**" />
    <EmbeddedResource Remove="Core/**;Tools/**" />
    <Page Remove="Core/**;Tools/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\3DMS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms n'est utilisé que via des noms complets (ColorDialog) : évite les conflits MenuItem/DataGrid/TextBox avec WPF -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetProjects.AvalonDock" Version="3.2.59" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\folder.png" />
    <Resource Include="Resources\session.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Map\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
