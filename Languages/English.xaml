<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- Ribbon Tabs -->
    <sys:String x:Key="TabSession">SESSION</sys:String>
    <sys:String x:Key="TabView">VIEW</sys:String>
    <sys:String x:Key="TabSettings">SETTINGS</sys:String>
    
    <!-- Session Tab -->
    <sys:String x:Key="BtnOpenSession">Open Session</sys:String>
    <sys:String x:Key="LblTrackDetected">Track Detected:</sys:String>
    
    <!-- View Tab -->
    <sys:String x:Key="ChkExplorer">Explorer</sys:String>
    <sys:String x:Key="ChkLapsTable">Laps</sys:String>
    <sys:String x:Key="ChkSessionInfo">Session Info</sys:String>
    <sys:String x:Key="ChkMap">Map</sys:String>
    <sys:String x:Key="ChkCharts">Telemetry</sys:String>
    
    <!-- Settings Tab Groups -->
    <sys:String x:Key="GrpSpeed">SPEED</sys:String>
    <sys:String x:Key="GrpAngleLeft">LEAN L</sys:String>
    <sys:String x:Key="GrpAngleRight">LEAN R</sys:String>
    <sys:String x:Key="GrpAccel">ACCEL (THROTTLE)</sys:String>
    <sys:String x:Key="GrpDecel">DECEL (BRAKE)</sys:String>
    <sys:String x:Key="GrpReference">REFERENCE</sys:String>
    <sys:String x:Key="GrpCompThicknessTel">COMP. TEL. (SLOW/FAST)</sys:String>
    <sys:String x:Key="GrpCompThicknessMap">COMP. MAP (SLOW/FAST)</sys:String>
    <sys:String x:Key="GrpResolution">RESOLUTION</sys:String>
