    <sys:String x:Key="LblTemp">Temp. (°C):</sys:String>
    <sys:String x:Key="LblTires">Tires:</sys:String>
    <sys:String x:Key="LblNotes">Notes:</sys:String>
    
    <!-- Placeholders -->
    <sys:String x:Key="PhAutoDetect">Auto-detect...</sys:String>
    <sys:String x:Key="PhEvent">Ex: Club racing...</sys:String>
    <sys:String x:Key="PhPilot">Choose or type...</sys:String>
    <sys:String x:Key="PhVehicle">Model...</sys:String>
    <sys:String x:Key="PhTires">Model, compound...</sys:String>
    <sys:String x:Key="PhNotes">Pressures, settings...</sys:String>
    
    <!-- Map Toolbar -->
    <sys:String x:Key="ChkInfoBadge">INFO BADGE</sys:String>
    <sys:String x:Key="LblRotation">ROTATION:</sys:String>
