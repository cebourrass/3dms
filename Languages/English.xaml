    <sys:String x:Key="LegSpeed">Speed</sys:String>
    <sys:String x:Key="LegAngleLeft">Angle L</sys:String>
    <sys:String x:Key="LegAngleRight">Angle R</sys:String>
    <sys:String x:Key="LegAccel">Accel</sys:String>
    <sys:String x:Key="LegDecel">Brake</sys:String>
    <sys:String x:Key="LegDelta">DELTA</sys:String>
    <sys:String x:Key="LegRef">REFERENCE</sys:String>
    
    <!-- Chart Axes -->
    <sys:String x:Key="AxisSpeed">Speed (km/h)</sys:String>
    <sys:String x:Key="AxisTime">Time (min:sec)</sys:String>
    <sys:String x:Key="AxisAngle">Angle (°) / G</sys:String>
    <sys:String x:Key="AxisDelta">Δ Time (s)</sys:String>
    <sys:String x:Key="LblBottomTime">TIME</sys:String>

    <!-- Settings: Accel Gradient -->
    <sys:String x:Key="LblAccelRange">Accel Color Range (G):</sys:String>
    <sys:String x:Key="ChkAutoAccelScaling">Auto-scale Colors (Min/Max)</sys:String>
    <sys:String x:Key="ChkAutoCenterMap">FOLLOW</sys:String>
</ResourceDictionary>
