    <sys:String x:Key="GrpSystem">SYSTEM</sys:String>
    <sys:String x:Key="GrpRegularityThresholds">REGULARITY THRESHOLDS (s)</sys:String>
    
    <sys:String x:Key="LblSmoothing">SMOOTHING</sys:String>
    <sys:String x:Key="LblSlow">Slow</sys:String>
    <sys:String x:Key="LblFast">Fast</sys:String>
    <sys:String x:Key="LblMapThickness">TRACE THICKNESS</sys:String>
    <sys:String x:Key="LblMapCursor">CURSOR</sys:String>
    <sys:String x:Key="ChkCorruptionAlert">Corruption Alert</sys:String>
    
    <!-- DataGrid Headers -->
    <sys:String x:Key="ColLap">Lap</sys:String>
    <sys:String x:Key="ColType">Type</sys:String>
    <sys:String x:Key="ColCumulative">Cumulative</sys:String>
    <sys:String x:Key="ColTime">Time</sys:String>
    <sys:String x:Key="ColVmax">Vmax</sys:String>
    <sys:String x:Key="ColVmin">Vmin</sys:String>
    <sys:String x:Key="ColLeft">Left</sys:String>
    <sys:String x:Key="ColRight">Right</sys:String>
    <sys:String x:Key="ColAccel">Accel</sys:String>
    <sys:String x:Key="ColDecel">Decel</sys:String>
    
    <!-- Regularity Stats -->
    <sys:String x:Key="LblRegularityTitle">REGULARITY (σ - Std Dev)</sys:String>
    <sys:String x:Key="LblExc">Exc.</sys:String>
    <sys:String x:Key="LblMoy">Avg.</sys:String>
    
    <!-- Session Info Panel -->
    <sys:String x:Key="LblDate">Date:</sys:String>
    <sys:String x:Key="LblCircuit">Track:</sys:String>
    <sys:String x:Key="LblEvent">Event:</sys:String>
    <sys:String x:Key="LblPilot">Rider:</sys:String>
    <sys:String x:Key="LblBest">Best:</sys:String>
    <sys:String x:Key="LblIdeal">Ideal:</sys:String>
