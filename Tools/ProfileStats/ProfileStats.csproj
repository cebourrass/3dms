<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outil en ligne de commande : calcule les mesures par circuit à partir des sessions .ra1
       et les écrit dans la section automatique d'une fiche pilote (coach/pilots/*.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>3dms-profile</AssemblyName>
    <RootNamespace>Analyzer.Tools.ProfileStats</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\3DMS.Core.csproj" />
  </ItemGroup>

</Project>
